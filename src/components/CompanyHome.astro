---
import { Image } from 'astro:assets';
import ContactBand from './ContactBand.astro';
import heroDevice from '../assets/images/hero-device.png';
import TechnologySteps from './TechnologySteps.astro';
import ExhibitionGallery from './ExhibitionGallery.astro';

const challenges = [
  { number: '01', title: '構造の壁', description: '人とは異なる数や形状、機能を有した対象は、\n身体の動きをそのまま写すだけでは操れません。' },
  { number: '02', title: '身体の壁', description: '動かせる部位や可動範囲は、人それぞれ。\nその人が使える動きや力から、操作の可能性を広げる必要があります。' },
  { number: '03', title: '空間の壁', description: '狭い室内や座った姿勢では、全身を大きく動かせません。その場の制約を超えて、操作先では自由に動ける仕組みが必要です。' },
];
const domains = [
  { number: '01', label: 'REMOTE OPERATION', title: '遠隔機械操作', description: '身体を大きく動かさずに機器を操作できるインタフェースを設計。\n身体特性に応じた入力で、遠隔作業に参加できる人を広げることを目指します。', href: '/solutions/#remote-ops' },
  { number: '02', label: 'WELFARE & REHABILITATION', title: '福祉・リハビリテーション', description: '身体機能を拡張し、自立をサポート。身体的制約のある方のリモート就労や、直感的な操作体験への応用を検討します。', href: '/solutions/#accessibility' },
  { number: '03', label: 'ENTERTAINMENT', title: 'エンターテインメント', description: 'アバタを自分の身体のように操作する、物理ベースの没入体験。\nVRゲームやe-sportsに、フィジカルなインタラクションの可能性を拓きます。', href: '/solutions/#xr' },
];
const process = [
  { number: '01', title: 'ヒアリング・課題整理', description: '業務課題や操作環境を伺い、技術の適用可能性と、検証すべき問いを一緒に整理します。', deliverable: '課題マップ・適用可能性レポート' },
  { number: '02', title: 'PoC設計・開発', description: 'インタラクション設計から、ハードウェア・ソフトウェアまで。動くプロトタイプを共同開発します。', deliverable: '動作プロトタイプ・技術検証レポート' },
  { number: '03', title: '効果検証', description: '課題に合ったユーザによる操作を通じて、操作負担・精度・習熟速度・主観評価を定量的に検証します。', deliverable: '検証結果・導入判断材料' },
  { number: '04', title: 'システム統合', description: '検証結果をもとに、既存システムへの統合や量産設計、運用に向けた開発を進めます。', deliverable: '製品版モジュール・統合ドキュメント' },
];
import { news as announcements } from '../data/news';
const news = announcements.slice(0, 3);

interface Props {
  showHero?: boolean;
}

const { showHero = true } = Astro.props;
---

    {showHero && (
    <section class="home-hero site-shell" aria-labelledby="hero-title">
      <div class="hero-topline"><p>YOUR UNIVERSAL BODY INTERFACE</p><span>人とデジタルの、新しい接点。</span></div>
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">身体性インタフェース</p>
          <h1 class="heading-xl" id="hero-title">指先の力で、<br />あらゆるものを<br /><span>動かす。</span></h1>
          <p class="hero-description">逆動力学で指の力を<br class="hero-mobile-break" />全身の関節トルクに変換。<br />遠隔操作に、身体の自由を。</p>
          <div class="hero-actions"><a class="button" href="/contact/">共同開発のご相談 <span aria-hidden="true">→</span></a><a class="text-link" href="/products/">技術を知る <span aria-hidden="true">→</span></a></div>
        </div>
        <figure class="hero-figure">
          <div class="figure-overline"><span>身体性インタフェース</span><span>指先力入力デバイス</span></div>
          <div class="hero-image"><Image src={heroDevice} alt="指に装着した身体性インタフェース。指先の力を検出するセンサを備えた入力デバイス" width={1026} widths={[480, 720, 1026]} sizes="(max-width: 800px) calc(100vw - 40px), (max-width: 1376px) calc(52vw - 50px), 666px" loading="eager" fetchpriority="high" /></div>
          <figcaption><span class="figure-cross" aria-hidden="true">＋</span><p>小さな力入力から、<br />多様な全身インタラクションへ。</p><a href="/products/" aria-label="身体性インタフェースの技術を詳しく見る">→</a></figcaption>
        </figure>
      </div>
      <div class="hero-credentials" aria-label="研究・受賞実績"><p><span>PUBLICATION</span> ACM UIST 2024 論文採択</p><p><span>AWARD</span> SIGGRAPH Asia 2024 Best Demo in Show Award</p></div>
    </section>
    )}

    <section class="section site-shell" aria-labelledby="challenge-title">
      <div class="home-section-heading"><p class="eyebrow"><span class="section-number">01</span> CHALLENGE</p><div class="section-heading"><h2 class="heading-lg" id="challenge-title">人とデジタルのあいだに、<br />まだ壁がある。</h2><p class="lead muted">遠隔操作、VR、ロボティクス。技術は進化しても、人が機械・アバタを<br />「自分の身体のように」動かせる世界には至っていません。</p></div></div>
      <div class="challenge-grid">{challenges.map((item) => <article class="challenge-item"><span class="small-number">{item.number}</span><h3>{item.title}</h3><p>{item.description.split('\n').map((line, index) => <>{index > 0 && <br />}{line}</>)}</p></article>)}</div>
      <div class="challenge-message"><h3>違いがあっても、操る感覚がつながる。</h3><p>自分の働きかけがどう伝わり、何が起きるのかを感じながら、思いどおりに動きを調整できる。<br />私たちは、そんな「自分の身体のように使える」体験を目指しています。</p></div>
    </section>

    <section class="section surface" id="technology" aria-labelledby="technology-title">
      <div class="site-shell">
        <div class="home-section-heading"><p class="eyebrow"><span class="section-number">02</span> TECHNOLOGY</p><div class="section-heading"><h2 class="heading-lg" id="technology-title">指先の力を、<br />全身の動きに。</h2><p class="lead muted">この身体性インタフェースでは、指先の力で全身アバタを操作できます。<br />入力した力と画面内の動きの対応を設計し、重さや硬さなどの感じ方を変えます。</p></div></div>
        <TechnologySteps />
        <div class="technology-footer"><p>タスク固有のモジュールなしに、<br class="desktop-break" />多様な全身インタラクションを可能にします。</p><a class="button button--outline" href="/products/">身体性インタフェースの技術・デモを見る <span aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section class="section site-shell" id="solutions" aria-labelledby="solutions-title">
      <div class="home-section-heading"><p class="eyebrow"><span class="section-number">03</span> SOLUTIONS</p><div class="section-heading"><h2 class="heading-lg" id="solutions-title">指先から、<br />さまざまな現場へ。</h2><p class="lead muted">お客様の課題に合わせて、力入力と動きのマッピング設計・PoC開発・効果検証を進めます。</p></div></div>
      <div class="domain-list">{domains.map((item) => <a class="domain-row" href={item.href}><span class="small-number">{item.number}</span><div class="domain-title"><p>{item.label}</p><h3>{item.title}</h3></div><p class="domain-description">{item.description.split('\n').map((line, index) => <>{index > 0 && <br />}{line}</>)}</p><span class="domain-arrow" aria-hidden="true">→</span></a>)}</div>
    </section>

    <section class="section surface section-rule" id="development" aria-labelledby="development-title">
      <div class="site-shell">
        <div class="home-section-heading"><p class="eyebrow"><span class="section-number">04</span> CO-DEVELOPMENT</p><div class="section-heading"><h2 class="heading-lg" id="development-title">課題の整理から、<br />動くプロトタイプまで。</h2><p class="lead muted">うつしみは、貸出・共同研究・開発委託を通じて、ヒアリングからPoC開発・効果検証まで伴走します。課題やアイデアの段階から、ご相談いただけます。</p></div></div>
        <ol class="development-steps">{process.map((step) => <li><span class="process-number">{step.number}</span><h3>{step.title}</h3><p class="process-description">{step.description}</p></li>)}</ol>
        <div class="development-outputs"><h3 class="outputs-label">成果物</h3><ol class="outputs-list">{process.map((step) => <li><span class="output-number">{step.number}</span><p>{step.deliverable}</p></li>)}</ol></div>
        <div class="development-link"><a class="text-link" href="/solutions/#engagement">提供形態と進め方を詳しく <span aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section class="section research-section" id="research" aria-labelledby="research-title">
      <div class="site-shell">
        <div class="home-section-heading"><p class="eyebrow"><span class="section-number">05</span> RESEARCH & RECOGNITION</p><div class="section-heading"><h2 class="heading-lg" id="research-title">研究に根ざし、<br />体験をつくる。</h2><p class="lead muted">国内外のカンファレンスで発表・展示を重ね、実際に体験いただいた方々からの評価が、複数の受賞につながっています。</p></div></div>
      </div>
      <ExhibitionGallery />
      <div class="site-shell">
        <div class="research-evidence"><div class="publication"><p class="eyebrow">PUBLICATION / 論文採択</p><h3>ACM UIST 2024</h3><p class="paper-title">Selfrionette: A Fingertip Force-Input Controller for Continuous Full-Body Avatar Manipulation</p><a class="text-link" href="/products/">研究・論文を見る <span aria-hidden="true">→</span></a></div><div class="awards"><p class="eyebrow">RECOGNITION / 受賞・採択</p><dl><div><dt>SIGGRAPH Asia 2024</dt><dd>Best Demo in Show Award</dd></div><div><dt>DCEXPO</dt><dd>NEDO賞</dd></div><div><dt>SIGGRAPH Special Prize</dt><dd>受賞</dd></div><div><dt>NEDO Entrepreneurs Program</dt><dd>2025年度 開拓コース採択</dd></div><div><dt>経済産業省 TIP</dt><dd>2024年度 先端テクノロジー社会実装プログラム採択</dd></div></dl></div></div>
        <div class="exhibition-record"><p>EXHIBITIONS & PRESENTATIONS</p><ul><li>SIGGRAPH 2025</li><li>Maker Faire Tokyo</li><li>日本VR学会全国大会</li></ul></div>
      </div>
    </section>

    <section class="section section-rule site-shell home-news" aria-labelledby="news-title">
      <div class="news-heading"><p class="eyebrow"><span class="section-number">06</span> NEWS</p><h2 class="heading-lg" id="news-title">最新情報</h2><a class="text-link" href="/news/">ニュース一覧 <span aria-hidden="true">→</span></a></div>
      <div class="news-list">{news.map((item) => <a href="/news/">{item.datetime ? <time datetime={item.datetime}>{item.date}</time> : <span class="news-date">{item.date}</span>}<span class="news-category">{item.category}</span><h3>{item.title}</h3><span class="news-arrow" aria-hidden="true">→</span></a>)}</div>
    </section>
    <ContactBand />

<style>
  .home-hero { padding-top: 24px; }
  .hero-topline { display: flex; justify-content: space-between; gap: 24px; border-top: 1px solid var(--color-text); border-bottom: 1px solid var(--color-border); padding: 17px 0; font-size: 12px; letter-spacing: .04em; }
  .hero-topline p { color: var(--color-brand); font-family: 'Sora Variable', sans-serif; }
  .hero-topline > span { color: var(--color-text-secondary); }
  .hero-grid { display: grid; grid-template-columns: 1fr 1.08fr; min-height: 662px; }
  .hero-copy { display: flex; flex-direction: column; align-items: flex-start; padding: 44px 30px 48px 0; }
  .hero-copy .eyebrow { letter-spacing: .06em; }
  .hero-copy h1 { margin-top: 26px; line-height: var(--line-title, 1.32); letter-spacing: -.05em; font-weight: 650; font-size: var(--size-title, clamp(48px, 4.55vw, 66px)); }
  .hero-copy h1 span { color: var(--color-brand); }
  .hero-description { font-size: var(--size-lead, 17px); line-height: var(--line-lead, 1.9); color: var(--color-text-secondary); margin-top: 26px; }
  .hero-mobile-break { display: none; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 24px; margin-top: auto; padding-top: 34px; }
  .hero-actions .button { gap: 25px; }
  .hero-actions .text-link { white-space: nowrap; }
  .hero-figure { position: relative; background: var(--color-surface-alt); display: flex; flex-direction: column; min-width: 0; }
  .figure-overline { position: absolute; z-index: 1; top: 20px; left: 25px; right: 25px; display: flex; justify-content: space-between; gap: 20px; font-size: 12px; color: var(--color-text-secondary); }
  .figure-overline > span { background: var(--color-surface-alt); padding: 4px 8px; }
  .figure-overline > span:first-child { font-family: 'Sora Variable', sans-serif; letter-spacing: .08em; }
  .hero-image { flex: 1; position: relative; overflow: hidden; min-height: 430px; }
  .hero-image img { position: absolute; width: 100%; height: 100%; object-fit: cover; object-position: 50% 48%; mix-blend-mode: multiply; filter: saturate(.9); }
  .hero-figure figcaption { display: flex; align-items: center; gap: 18px; border-top: 1px solid var(--color-border); padding: 19px 25px; font-size: 13px; line-height: 1.7; }
  .figure-cross { color: var(--color-brand); font-size: 27px; font-weight: 300; }
  .hero-figure figcaption a { display: grid; place-items: center; border: 1px solid var(--color-border-strong); width: 44px; height: 44px; margin-left: auto; flex-shrink: 0; font-size: 24px; }
  .hero-credentials { display: flex; flex-wrap: wrap; gap: 15px 48px; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-text); padding: 23px 0; font-size: 13px; }
  .hero-credentials p { display: flex; align-items: baseline; gap: 16px; }
  .hero-credentials p > span { font-family: 'Sora Variable', sans-serif; font-size: 12px; color: var(--color-brand); letter-spacing: .03em; }
  .home-section-heading { display: grid; grid-template-columns: 1fr 2fr; gap: 44px; }
  .home-section-heading > .eyebrow { display: flex; align-items: baseline; gap: 20px; padding-top: 10px; font-size: var(--size-label, var(--home-label-size, 12pt)); }
  .home-section-heading .section-heading { max-width: 730px; margin-bottom: 0; }
  .home-section-heading .lead { margin-top: 23px; }
  .section-number { font-family: 'Sora Variable', sans-serif; }
  .challenge-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--color-text); border-bottom: 1px solid var(--color-border); margin-top: 52px; }
  .challenge-item { padding: 30px 30px 35px; border-left: 1px solid var(--color-border); }
  .challenge-item:first-child { border-left: 0; padding-left: 0; }
  .challenge-item:last-child { padding-right: 0; }
  .small-number { color: var(--color-brand); font-family: 'Sora Variable', sans-serif; font-size: 12px; }
  .challenge-item h3 { font-size: var(--size-subheading, 23px); font-weight: 600; margin-top: 22px; }
  .challenge-item p { font-size: var(--size-description, 16px); color: var(--color-text-secondary); line-height: var(--line-description, 1.95); margin-top: 16px; }
  .technology-footer { display: flex; align-items: center; justify-content: space-between; gap: 32px; padding-top: 30px; }
  .technology-footer > p { font-size: var(--size-description, 16px); color: var(--color-text-secondary); line-height: var(--line-description, 1.85); }
  .domain-list { margin-top: 50px; border-top: 1px solid var(--color-text); }
  .domain-row { display: grid; grid-template-columns: 35px 1fr 1fr 30px; gap: 26px; align-items: center; padding: 36px 0; border-bottom: 1px solid var(--color-border); }
  .domain-row > .small-number { align-self: start; padding-top: 3px; }
  .domain-title > p { font-family: 'Sora Variable', sans-serif; color: var(--color-text-secondary); font-size: var(--size-label, 12px); letter-spacing: .02em; }
  .domain-title h3 { font-size: var(--size-subheading, 25px); font-weight: 550; letter-spacing: -.025em; margin-top: 10px; line-height: var(--line-subheading, 1.6); }
  .domain-description { font-size: var(--size-description, 16px); color: var(--color-text-secondary); line-height: var(--line-description, 1.95); }
  .domain-arrow { justify-self: end; font-size: 30px; font-weight: 300; }
  .domain-row:hover .domain-title h3, .domain-row:hover .domain-arrow { color: var(--color-brand); }
  .development-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 27px; list-style: none; padding: 0; margin: 55px 0 0; }
  .development-steps li { border-top: 1px solid var(--color-border-strong); padding-top: 24px; display: flex; flex-direction: column; }
  .process-number { font-family: 'Sora Variable', sans-serif; font-size: 33px; color: var(--color-brand); letter-spacing: -.04em; line-height: 1; }
  .development-steps h3 { margin-top: 22px; font-size: var(--size-subheading, 19px); font-weight: 600; line-height: var(--line-subheading, 1.65); letter-spacing: -.03em; }
  .process-description { font-size: var(--size-description, 16px); color: var(--color-text-secondary); line-height: var(--line-description, 1.9); padding-top: 17px; padding-bottom: 25px; }
  .development-link { display: flex; justify-content: flex-end; border-top: 1px solid var(--color-border); padding-top: 24px; margin-top: 38px; }
  .research-evidence { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 64px; margin-top: 48px; border-top: 1px solid var(--color-text); }
  .publication { padding: 24px 0 0; }
  .publication h3 { font-family: 'Sora Variable', sans-serif; font-size: var(--size-subheading, 30px); font-weight: 500; letter-spacing: -.03em; line-height: var(--line-subheading, 1.5); margin-top: 15px; }
  .paper-title { font-family: 'Sora Variable', sans-serif; font-size: 14px; color: var(--color-text-secondary); line-height: 1.8; margin-top: 14px; }
  .publication .text-link { margin-top: 21px; }
  .awards { padding-top: 24px; }
  .awards dl { margin: 20px 0 0; }
  .awards dl > div { display: flex; justify-content: space-between; gap: 22px; align-items: baseline; margin-top: 17px; }
  .awards dt { font-family: 'Sora Variable', sans-serif; font-size: 14px; font-weight: 500; }
  .awards dd { font-size: 13px; color: var(--color-text-secondary); margin: 0; text-align: right; }
  .exhibition-record { display: flex; flex-wrap: wrap; align-items: baseline; gap: 18px 32px; border-top: 1px solid var(--color-border); padding-top: 24px; margin-top: 33px; }
  .exhibition-record > p { font-family: 'Sora Variable', sans-serif; font-size: var(--size-description, 12px); color: var(--color-text-secondary); letter-spacing: .02em; }
  .exhibition-record ul { display: flex; flex-wrap: wrap; gap: 12px 30px; padding: 0; margin: 0; list-style: none; font-size: 14px; }
  .home-news { display: grid; grid-template-columns: 1fr 2fr; gap: 44px; }
  .news-heading .eyebrow { display: flex; gap: 20px; align-items: baseline; }
  .news-heading h2 { margin-top: 24px; }
  .news-heading .text-link { margin-top: 28px; }
  .news-list { border-top: 1px solid var(--color-text); }
  .news-list > a { display: grid; grid-template-columns: 78px 70px 1fr 22px; align-items: baseline; column-gap: 20px; padding: 29px 0; border-bottom: 1px solid var(--color-border); }
  .news-list time, .news-date { font-family: 'Sora Variable', sans-serif; font-size: 13px; color: var(--color-text-secondary); }
  .news-category { font-size: 12px; color: var(--color-brand); }
  .news-list h3 { font-size: var(--size-subheading, 16px); font-weight: 500; line-height: var(--line-subheading, 1.85); }
  .news-arrow { font-size: 21px; justify-self: end; }
  .news-list > a:hover h3, .news-list > a:hover .news-arrow { color: var(--color-brand); }

  @media (max-width: 1150px) {
    .hero-grid { min-height: 610px; grid-template-columns: 1fr 1fr; }
    .hero-copy { padding-right: 24px; }
    .hero-copy h1 { font-size: var(--size-title, 51px); }
    .hero-description { font-size: var(--size-lead, 16px); }
    .hero-actions { gap: 17px; }
    .hero-actions .button { padding-inline: 19px; font-size: 14px; gap: 18px; }
    .hero-actions .text-link { font-size: 14px; }
    .hero-credentials { gap: 14px 25px; font-size: 12px; }
    .hero-credentials p { gap: 11px; }
    .home-section-heading { grid-template-columns: 1fr 2.2fr; gap: 32px; }
    .home-section-heading > .eyebrow { gap: 12px; font-size: var(--size-label, var(--home-label-size, 12pt)); }
    .challenge-item { padding-inline: 23px; }
    .challenge-item p { font-size: var(--size-description, 16px); }
    .domain-row { grid-template-columns: 25px 1fr 1fr 26px; gap: 19px; }
    .domain-title h3 { font-size: var(--size-subheading, 22px); }
    .domain-description { font-size: var(--size-description, 16px); }
    .development-steps { gap: 22px; }
    .development-steps h3 { font-size: var(--size-subheading, 17px); min-height: 56px; }
    .process-description { font-size: var(--size-description, 16px); }
    .research-evidence { gap: 40px; }
    .awards dl > div { display: block; margin-top: 16px; }
    .awards dd { text-align: left; margin-top: 5px; }
    .home-news { grid-template-columns: 1fr 2.2fr; gap: 32px; }
    .news-list > a { grid-template-columns: 71px 58px 1fr 20px; gap: 15px; }
    .news-list h3 { font-size: var(--size-subheading, 16px); }
  }

  @media (max-width: 800px) {
    .home-hero { padding-top: 12px; }
    .hero-topline { font-size: 12px; padding: 13px 0; letter-spacing: .03em; }
    .hero-topline > span { display: none; }
    .hero-grid { display: flex; flex-direction: column; min-height: 0; }
    .hero-copy { padding: 31px 0 36px; }
    .hero-copy .eyebrow { font-size: var(--size-label, 12px); }
    .hero-copy h1 { font-size: var(--size-title, clamp(42px, 9vw, 58px)); margin-top: 22px; letter-spacing: -.055em; line-height: var(--line-title, 1.36); }
