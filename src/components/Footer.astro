---
import Brand from './Brand.astro';
import { company } from '../data/company';
const nav = [
  { label: 'ホーム', href: '/' },
  { label: '事業領域', href: '/solutions/' },
  { label: '身体性インタフェースの技術', href: '/products/' },
  { label: '私たちについて', href: '/company/' },
  { label: 'お知らせ', href: '/news/' },
  { label: 'お問い合わせ', href: '/contact/' },
];
---
<footer class="site-footer">
  <div class="site-shell">
    <div class="footer-main">
      <div class="footer-brand"><Brand /><p>身体の自由を、指先から。</p></div>
      <nav aria-label="フッターナビゲーション">{nav.map(item => <a href={item.href}>{item.label}<span aria-hidden="true">→</span></a>)}</nav>
      <div class="footer-company"><p>{company.legalName}</p><p class="address">{company.registeredAddress}</p><a href="/contact/">お問い合わせフォーム</a></div>
    </div>
    <div class="footer-bottom"><small>© {new Date().getFullYear()} {company.brandName}</small><a href="/privacy/">プライバシーポリシー</a><a class="back-top" href="#main-content">ページの先頭へ <span aria-hidden="true">↑</span></a></div>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--color-border); background: var(--color-surface); padding-top: 64px; }
  .footer-main { display: grid; grid-template-columns: 1.3fr .8fr 1fr; gap: 64px; padding-bottom: 56px; }
  .footer-brand p { margin-top: 20px; color: var(--color-text-secondary); font-size: var(--size-description, 14px); }
  nav { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; }
  nav a { display: flex; align-items: center; justify-content: space-between; gap: 32px; min-height: 40px; width: 100%; max-width: 180px; font-size: 13px; }
  nav a span { color: var(--color-text-tertiary); }
  a:hover { color: var(--color-brand); }
  .footer-company { font-size: 13px; }
  .address { color: var(--color-text-secondary); margin-top: 12px; max-width: 320px; }
  .footer-company > a { display: inline-flex; align-items: center; min-height: 44px; margin-top: 16px; color: var(--color-text-secondary); text-decoration: underline; text-underline-offset: 5px; }
  .footer-bottom { display: flex; align-items: center; gap: 32px; border-top: 1px solid var(--color-border); padding-block: 16px; color: var(--color-text-secondary); font-size: 12px; }
  small { font: 11px var(--font-display); margin-right: auto; }
  .footer-bottom a { display: inline-flex; align-items: center; min-height: 44px; }
  .back-top { gap: 20px; }
  @media(max-width:1000px) { .footer-main { gap: 32px; grid-template-columns: 1fr .8fr 1fr; } }
  @media(max-width:760px) {
    .site-footer { padding-top: 44px; }.footer-main { grid-template-columns: 1fr 1fr; gap: 32px 20px; padding-bottom: 32px; }
    .footer-brand { grid-column: 1/-1; }.footer-brand p { margin-top: 12px; }.footer-company { grid-column: 1/-1; }
    nav { grid-column: 1/-1; display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; }
    nav a { max-width: none; min-height: 44px; gap: 12px; }
    .footer-bottom { flex-wrap: wrap; gap: 0 24px; padding-block: 16px; }.footer-bottom small { width: 100%; margin-bottom: 8px; }.back-top { margin-left: auto; }
  }
  @media(max-width:360px) { .footer-bottom { gap: 0 16px; font-size: 11px; }.back-top { gap: 10px; } }
</style>
