<section class="cinema-intro" data-cinema-intro aria-labelledby="cinema-title">
  <div class="cinema-stage">
    <div class="cinema-frame">
      <img class="cinema-poster" src="/images/landing-hero-poster.jpg" width="924" height="884" alt="" fetchpriority="high" />
      <video class="cinema-video" muted loop playsinline preload="metadata" aria-hidden="true" tabindex="-1" poster="/images/landing-hero-poster.jpg">
        <source src="/videos/device-motion.mp4" type="video/mp4" />
      </video>
      <div class="cinema-shade" aria-hidden="true"></div>
      <div class="cinema-content">
        <div class="cinema-copy">
          <h1 id="cinema-title">指先の力で、<br />動かす可能性。</h1>
          <p class="cinema-description">人とデジタルの、新しい接点。<br />身体の可能性をひらく、うつしみ。</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initializeIntroSnap } from '../scripts/introSnap';
  const intro = document.querySelector<HTMLElement>('[data-cinema-intro]');
  if (intro) {
    const stage = intro.querySelector<HTMLElement>('.cinema-stage')!;
    const video = intro.querySelector<HTMLVideoElement>('video')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let inView = true;
    let videoFailed = false;
    let playbackBlocked = false;
    let progress = 0;
    let target = 0;
    let frame = 0;
    let previousTime = 0;

    const syncVideo = () => {
      if (videoFailed) return;
      if (!reduced.matches && !playbackBlocked && inView && !document.hidden) {
        video.play().catch((error: DOMException) => {
          // Offscreen pauses can abort a pending play request. Only an autoplay
          // restriction should stop subsequent attempts to resume the video.
          if (error.name === 'NotAllowedError') playbackBlocked = true;
        });
      } else video.pause();
    };
    const render = () => {
      intro.style.setProperty('--intro-progress', progress.toFixed(5));
      intro.dataset.progress = progress.toFixed(3);
      intro.style.setProperty('--copy-opacity', Math.max(0, 1 - progress * 1.6).toFixed(4));
    };
    const tick = (time: number) => {
      const delta = Math.min(time - (previousTime || time - 16), 64);
      previousTime = time;
      progress += (target - progress) * (1 - Math.exp(-delta / 85));
      if (Math.abs(target - progress) < .0002) progress = target;
      render();
      if (progress !== target) frame = requestAnimationFrame(tick);
      else { frame = 0; previousTime = 0; }
    };
    const measure = () => {
      if (reduced.matches) {
        target = progress = 0;
        render();
        return;
      }
      const bounds = intro.getBoundingClientRect();
      const travel = Math.max(1, intro.offsetHeight - stage.offsetHeight);
      const raw = Math.max(0, Math.min(1, -bounds.top / travel));
      target = raw * raw * (3 - 2 * raw);
      if (!frame) frame = requestAnimationFrame(tick);
    };
    const syncMotion = () => {
      intro.toggleAttribute('data-motion', !reduced.matches);
      if (reduced.matches) {
        cancelAnimationFrame(frame);
        frame = 0;
        previousTime = 0;
      }
      measure();
      syncVideo();
    };
    video.addEventListener('playing', () => { intro.dataset.videoReady = 'true'; });
    const onVideoError = () => {
      videoFailed = true;
      video.pause();
      delete intro.dataset.videoReady;
    };
    video.addEventListener('error', onVideoError);
    video.querySelector('source')?.addEventListener('error', onVideoError);
    if (video.error) onVideoError();
    const observer = new IntersectionObserver(entries => {
      inView = entries[0].isIntersecting;
      syncVideo();
    });
    observer.observe(stage);
    document.addEventListener('visibilitychange', syncVideo);
    window.addEventListener('scroll', measure, { passive: true });
    window.addEventListener('resize', measure, { passive: true });
    window.addEventListener('pageshow', measure);
    reduced.addEventListener('change', syncMotion);
    syncMotion();
    const company = document.querySelector<HTMLElement>('#company-overview');
    const disposeSnap = company ? initializeIntroSnap(intro, company, reduced, () => document.querySelector<HTMLElement>('[data-intro-header]')?.offsetHeight ?? 0) : undefined;
    document.addEventListener('astro:before-swap', () => {
      disposeSnap?.();
      observer.disconnect();
      cancelAnimationFrame(frame);
      video.pause();
      document.removeEventListener('visibilitychange', syncVideo);
      window.removeEventListener('scroll', measure);
      window.removeEventListener('resize', measure);
      window.removeEventListener('pageshow', measure);
      reduced.removeEventListener('change', syncMotion);
    }, { once: true });
  }
</script>

<style>
  .cinema-intro { --intro-progress: 0; --copy-opacity: 1; position: relative; height: 100svh; min-height: 580px; background: var(--color-surface); }
  .cinema-intro[data-motion] { height: 160svh; min-height: 928px; }
  .cinema-stage { position: sticky; top: 0; height: 100svh; min-height: 580px; overflow: clip; }
  .cinema-frame { position: relative; width: 100%; height: 100%; overflow: hidden; color: #fff; background: #102137; }
  .cinema-poster, .cinema-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 47%; transform: scale(calc(1 + var(--intro-progress) * .32)); transform-origin: 50% 48%; will-change: transform; }
  .cinema-video { opacity: 0; }
  [data-video-ready] .cinema-video { opacity: 1; }
  .cinema-shade { position: absolute; inset: 0; background: linear-gradient(90deg, #071932d9 0%, #092b537d 52%, #051c3838 100%), linear-gradient(0deg, #031327ad, transparent 45%, #02102366); }
  .cinema-content { position: relative; z-index: 1; height: 100%; display: flex; flex-direction: column; padding: 92px 4.5vw 32px; }
  .cinema-copy { margin-block: auto; padding-block: 60px 74px; opacity: var(--copy-opacity); transform: translateY(calc(var(--intro-progress) * -30px)) scale(calc(1 + var(--intro-progress) * .08)); transform-origin: left center; }
  h1 { font-size: var(--size-title, clamp(54px, 6.5vw, 96px)); font-weight: 550; letter-spacing: -.06em; line-height: var(--line-title, 1.38); }
  .cinema-description { margin-top: 28px; color: #f0f4fa; font-size: var(--size-lead, 16px); line-height: var(--line-lead, 1.95); }
  .cinema-frame :focus-visible { outline-color: #fff; }
  @media(min-width: 1600px) { .cinema-content { padding-inline: 6vw; } }
  @media(max-width: 760px) {
    .cinema-intro, .cinema-stage { min-height: 580px; }
    .cinema-intro[data-motion] { min-height: 928px; }
    .cinema-content { padding: 76px 24px 25px; }
    .cinema-poster, .cinema-video { object-position: 58% center; }
    .cinema-shade { background: linear-gradient(90deg, #04172bbf, #071e3980), linear-gradient(0deg, #031327b8, transparent 62%, #02102355); }
    .cinema-copy { padding-block: 52px 72px; }
    h1 { font-size: var(--size-title, clamp(34px, 8.7vw, 60px)); line-height: var(--line-title, 1.55); }
    .cinema-description { font-size: var(--size-lead, 14px); margin-top: 24px; }
  }
  @media(max-width: 360px) {
    .cinema-content { padding-inline: 20px; }
    h1 { font-size: var(--size-title, 32px); }
  }
  @media(max-height: 620px) {
    .cinema-intro, .cinema-stage { min-height: 100svh; }
    .cinema-intro[data-motion] { min-height: 160svh; }
    .cinema-content { padding-block: 92px 16px; }
    .cinema-copy { padding-block: 18px; }
    h1 { font-size: var(--size-title, clamp(32px, 5vw, 60px)); line-height: var(--line-title, 1.3); }
    .cinema-description { margin-top: 12px; font-size: var(--size-lead, 13px); }
  }
  @media(max-width:760px) and (max-height:620px) {
    .cinema-content { padding-top: 76px; }
  }
  @media(max-width:760px) and (max-height:480px) {
    .cinema-copy { padding-block: 8px; }
    .cinema-description { font-size: var(--size-lead, 12px); }
  }
  @media(prefers-reduced-motion: reduce) {
    .cinema-poster, .cinema-video, .cinema-copy { transform: none; will-change: auto; }
    .cinema-copy { opacity: 1; }
  }
</style>
