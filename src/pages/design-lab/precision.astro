---
import { Image } from 'astro:assets';
import DesignConceptLayout from '../../layouts/DesignConceptLayout.astro';
import device from '../../assets/images/hero-device.png';
import exhibition from '../../assets/images/2026-10-14_exhibition-demo-crop-mosaic_v1.webp';

const challenges = [
  { number: '01', title: '操作の壁', description: '遠隔操作やVR空間での作業は、従来のコントローラでは直感的に動かせません。習熟に時間がかかり、導入が進まない原因になっています。' },
  { number: '02', title: '感覚の壁', description: '画面越しでは、触れたものの硬さや重さがわかりません。力覚フィードバックの不在が、操作精度と安心感の両方を損なっています。' },
  { number: '03', title: '身体の壁', description: '全身の動きに依存する操作方法では、身体的制約のある方や狭い空間での利用に限界があります。さらに、人とは形状や動きの異なるアバタ・機械をどう操作するかも課題です。' },
];
const domains = [
  { number: '01', label: 'REMOTE OPERATION', title: '遠隔重機操作', description: '身体を大きく動かさずに重機を操作できるインタフェースを設計。身体特性に応じた入力で、遠隔作業に参加できる人を広げることを目指します。', href: '/solutions#remote-ops' },
  { number: '02', label: 'WELFARE & REHABILITATION', title: '福祉・リハビリテーション', description: '身体機能を拡張し、自立をサポート。身体障害当事者のリモート就労を可能にし、力覚フィードバックによる安全で直感的な操作体験を提供します。', href: '/solutions#accessibility' },
  { number: '03', label: 'ENTERTAINMENT', title: 'エンターテインメント', description: 'アバタを自分の身体のように操作する、物理ベースの没入体験。VRゲームやe-sportsに、フィジカルなインタラクションの新次元を拓きます。', href: '/solutions#xr' },
];
const process = [
  { number: '01', title: 'ヒアリング・課題整理', time: '1〜2週間', body: '業務課題・操作環境・既存システムをヒアリング。HCI研究の視点から、インタラクションのボトルネックを一緒に整理します。', output: '課題マップ・適用可能性レポート' },
  { number: '02', title: 'PoC設計・プロトタイプ開発', time: '1〜3ヶ月', body: 'センサデバイス設計、VR・シミュレーション環境構築、インタラクション設計まで。動作するプロトタイプを共同開発します。', output: '動作プロトタイプ・技術検証レポート' },
  { number: '03', title: '効果検証・ユーザテスト', time: '1〜2ヶ月', body: '身体特性や使える動きの異なるユーザーによる操作を通じて、操作負担・精度・習熟速度・主観評価を定量的に検証します。', output: '検証結果・導入判断材料' },
  { number: '04', title: '本開発・システム統合', time: '要相談', body: 'PoC検証結果をもとに、既存システムへの統合・量産設計を進めます。運用開始後のサポートも継続的に提供します。', output: '製品版モジュール・統合ドキュメント' },
];
const news = [
  { date: '2024.12', category: '受賞', title: 'SIGGRAPH Asia 2024 Best Demo in Show Award を受賞しました' },
  { date: '2024.10', category: '受賞', title: 'DCEXPO NEDO賞・SIGGRAPH Special Prize をダブル受賞しました' },
  { date: '2024.10', category: '学会発表', title: 'ACM UIST 2024にて「Selfrionette」論文が採択されました' },
];
---

<DesignConceptLayout title="C — Precision" concept="precision">
  <div class="precision-site">
    <header class="site-header wrap">
      <a class="wordmark brand-jp" href="/design-lab/precision" aria-label="うつしみ トップ"><span class="brand-mark" aria-hidden="true"></span>うつしみ</a>
      <nav class="desktop-nav" aria-label="メインナビゲーション">
        <a href="#solutions">事業領域</a>
        <a href="#technology">技術</a>
        <a href="#research">研究・実績</a>
        <a href="/company">会社情報</a>
      </nav>
      <a class="header-contact" href="/contact">お問い合わせ <span aria-hidden="true">↗</span></a>
      <details class="mobile-menu">
        <summary>メニュー <span aria-hidden="true">＋</span></summary>
        <nav aria-label="モバイルナビゲーション">
          <a href="#solutions">事業領域</a><a href="#technology">技術</a><a href="#research">研究・実績</a><a href="/company">会社情報</a><a href="/contact">お問い合わせ ↗</a>
        </nav>
      </details>
    </header>

    <main>
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-topline"><p>身体性インタフェース</p><span>HUMAN–MACHINE INTERACTION</span></div>
        <div class="hero-main">
          <div class="hero-copy">
            <p class="eyebrow"><span class="tiny-square" aria-hidden="true"></span>身体の自由を、指先から。</p>
            <h1 id="hero-title">指先の力で、<br />あらゆるものを<br /><span>動かす。</span></h1>
            <p class="hero-description">逆動力学で指の力を全身の関節トルクに変換。<br />遠隔操作に、身体の自由を。</p>
            <div class="hero-actions"><a class="button" href="/contact">共同開発のご相談 <span aria-hidden="true">↗</span></a><a class="text-link" href="#technology">技術を知る <span aria-hidden="true">↓</span></a></div>
          </div>
          <figure class="device-plane">
            <div class="plane-title"><span>身体性インタフェース</span><span>指先力入力インタフェース</span></div>
            <div class="device-photo"><Image src={device} alt="手に装着した身体性インタフェースの指先力入力デバイス" widths={[640, 960, 1280]} sizes="(max-width: 780px) 100vw, 53vw" loading="eager" fetchpriority="high" /></div>
            <figcaption><span class="cross" aria-hidden="true">＋</span><span>小さな力入力から、<br />多様な全身インタラクションへ。</span><a href="/products" aria-label="身体性インタフェースの技術詳細">↗</a></figcaption>
          </figure>
        </div>
        <div class="hero-foot"><p><span>RESEARCH</span> ACM UIST 2024 論文採択</p><p><span>AWARD</span> SIGGRAPH Asia 2024 Best Demo in Show Award</p><a href="#challenge">EXPLORE <span aria-hidden="true">↓</span></a></div>
      </section>

      <section class="challenge section wrap" id="challenge" aria-labelledby="challenge-title">
        <div class="section-intro"><p class="section-label"><span>01</span> CHALLENGE</p><div><h2 id="challenge-title">人とデジタルのあいだに、<br />まだ壁がある。</h2><p class="intro-copy">遠隔操作、VR、ロボティクス。技術は進化しても、人が機械を「自分の身体のように」動かせる世界には至っていません。</p></div></div>
        <div class="challenge-grid">{challenges.map((item) => <article><span class="item-number">{item.number}</span><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
      </section>

      <section class="technology section" id="technology" aria-labelledby="technology-title">
        <div class="wrap">
          <div class="section-intro"><p class="section-label"><span>02</span> TECHNOLOGY</p><div><h2 id="technology-title">身体の可能性を拡げる<br />身体性インタフェース。</h2></div></div>
          <div class="technology-main">
            <div class="technology-copy"><p class="english-heading">Embodied<br />Interface</p><p>指先の力入力インタフェースにより、全身アバタの操作と力覚フィードバックを実現。タスク固有のモジュールなしに、棒揺らし・押す・泳ぐ・登るなど、多様な全身インタラクションを可能にします。</p><a class="text-link" href="/products">技術の詳細を見る <span aria-hidden="true">↗</span></a></div>
            <div class="technology-specs"><div><span>INPUT</span><p>指力入力 <b>片手7自由度</b></p></div><div><span>TRANSFORM</span><p>逆動力学変換</p></div><div><span>FEEDBACK</span><p>力覚フィードバック</p></div><div><span>INTERACTION</span><p>全身アバタ操作</p></div></div>
          </div>
          <div class="technical-flow" aria-label="指先の力から全身操作への変換"><div><span>01 / INPUT</span><p>指先の力</p></div><span class="flow-arrow" aria-hidden="true">→</span><div><span>02 / COMPUTATION</span><p>逆動力学変換</p></div><span class="flow-arrow" aria-hidden="true">→</span><div><span>03 / INTERACTION</span><p>全身の動き</p></div></div>
        </div>
      </section>

      <section class="domains section wrap" id="solutions" aria-labelledby="solutions-title">
        <div class="section-intro"><p class="section-label"><span>03</span> SOLUTIONS</p><div><h2 id="solutions-title">指先から、<br />さまざまな現場へ。</h2><p class="intro-copy">お客様の課題に合わせた力覚マッピングの設計・PoC開発・効果検証を、一貫してサポートします。</p></div></div>
        <div class="domain-list">{domains.map((item) => <a href={item.href} class="domain-row"><span class="domain-number">{item.number}</span><div class="domain-title"><p>{item.label}</p><h3>{item.title}</h3></div><p class="domain-description">{item.description}</p><span class="domain-arrow" aria-hidden="true">↗</span></a>)}</div>
      </section>

      <section class="development section" id="development" aria-labelledby="development-title">
        <div class="wrap">
          <div class="section-intro"><p class="section-label"><span>04</span> CO-DEVELOPMENT</p><div><h2 id="development-title">課題の整理から、<br />動くプロトタイプまで。</h2><p class="intro-copy">うつしみは身体性技術の研究チームとして、ヒアリングからPoC開発・効果検証まで一貫して伴走します。</p></div></div>
          <div class="process-grid">{process.map((step) => <article><div class="process-top"><span>{step.number}</span><p>{step.time}</p></div><h3>{step.title}</h3><p class="process-description">{step.body}</p><div class="deliverable"><span>成果物</span><p>{step.output}</p></div></article>)}</div>
          <div class="process-foot"><p>課題やアイデアの段階から、ご相談いただけます。</p><a class="text-link" href="/solutions">共同開発の進め方 <span aria-hidden="true">↗</span></a></div>
        </div>
      </section>

      <section class="research section wrap" id="research" aria-labelledby="research-title">
        <div class="section-intro"><p class="section-label"><span>05</span> RESEARCH & RECOGNITION</p><div><h2 id="research-title">研究に根ざし、<br />体験をつくる。</h2><p class="intro-copy">国内外のカンファレンスで発表・展示を重ね、実際に体験いただいた方々からの評価が、複数の受賞につながっています。</p></div></div>
        <div class="research-grid">
          <figure class="research-photo"><Image class="demo-photo-cropped" src={exhibition} alt="展示会で身体性インタフェースを使ったVRデモを体験する来場者と、説明する研究者" width={1280} widths={[640, 960, 1280]} sizes="(max-width: 780px) calc(100vw - 40px), (max-width: 1100px) calc(50vw - 50px), (max-width: 1440px) calc(50vw - 86px), 634px" loading="lazy" /><figcaption>展示会でのデモンストレーション</figcaption></figure>
          <div class="research-list"><div class="publication"><p class="eyebrow">PUBLICATION / 論文採択</p><h3>ACM UIST 2024</h3><p>Selfrionette: A Fingertip Force-Input Controller for Continuous Full-Body Avatar Manipulation</p><a class="text-link" href="/products">研究・論文を見る <span aria-hidden="true">↗</span></a></div><div class="awards"><p class="eyebrow">AWARDS / 受賞</p><dl><div><dt>SIGGRAPH Asia 2024</dt><dd>Best Demo in Show Award</dd></div><div><dt>DCEXPO</dt><dd>NEDO賞</dd></div><div><dt>SIGGRAPH Special Prize</dt><dd>受賞</dd></div></dl></div></div>
        </div>
      </section>

      <section class="news section wrap" id="news" aria-labelledby="news-title">
        <div class="news-heading"><p class="section-label"><span>06</span> NEWS</p><h2 id="news-title">最新情報</h2><a class="text-link" href="/news">一覧を見る <span aria-hidden="true">↗</span></a></div>
        <div class="news-list">{news.map((item) => <a href="/news"><time>{item.date}</time><span class="news-category">{item.category}</span><h3>{item.title}</h3><span class="news-arrow" aria-hidden="true">↗</span></a>)}</div>
      </section>

      <section class="contact-section" aria-labelledby="contact-title"><div class="wrap contact-inner"><div><p class="eyebrow">LET’S BUILD TOGETHER.</p><h2 id="contact-title">次の可能性を、<br />一緒につくりませんか。</h2><p>技術デモのご依頼、共同研究のご相談など、<br class="desktop-break" />お気軽にお問い合わせください。</p></div><a href="/contact" class="contact-link"><span>共同開発・導入のご相談</span><span aria-hidden="true">↗</span></a></div></section>
    </main>

    <footer class="site-footer wrap"><div class="footer-top"><a class="wordmark brand-jp" href="/design-lab/precision" aria-label="うつしみ トップ"><span class="brand-mark" aria-hidden="true"></span>うつしみ</a><p>うつしみ株式会社</p><nav aria-label="フッターナビゲーション"><a href="/solutions">ソリューション</a><a href="/products">技術</a><a href="/company">会社情報</a><a href="/contact">お問い合わせ</a></nav></div><div class="footer-bottom"><small>© Utsushimi. All rights reserved.</small><a href="/privacy">プライバシーポリシー</a></div></footer>
  </div>
</DesignConceptLayout>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.precision-site .mobile-menu');
  if (menu) {
    menu.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
      link.addEventListener('click', () => { menu.open = false; });
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  .precision-site .contact-section a:focus-visible{outline-color:#fff}
  .precision-site{--ink:#20272c;--muted:#626c76;--blue:#164fcb;--line:#d5dce2;--pale:#f0f3f6;color:var(--ink);background:#fff;font-family:'Noto Sans JP Variable',sans-serif;font-size:15px;line-height:1.8;-webkit-font-smoothing:antialiased}
  .precision-site *{box-sizing:border-box}.precision-site a{color:inherit;text-decoration:none}.precision-site p,.precision-site h1,.precision-site h2,.precision-site h3,.precision-site figure,.precision-site dl,.precision-site dd{margin:0}.precision-site a:focus-visible,.precision-site summary:focus-visible{outline:3px solid var(--blue);outline-offset:6px}.precision-site a{transition:color .2s,background .2s}.precision-site a:hover{color:var(--blue)}.precision-site section[id]{scroll-margin-top:28px}.wrap{width:calc(100% - 112px);max-width:1328px;margin-inline:auto}.site-header{min-height:100px;display:flex;align-items:center;gap:46px}.wordmark{display:flex;align-items:center;gap:10px;font-family:'Sora Variable',sans-serif;font-size:35px;font-weight:650;letter-spacing:-2px;line-height:1}.wordmark-period{color:var(--blue);margin-left:-10px}.brand-mark{display:block;width:15px;height:26px;background:var(--blue);clip-path:polygon(0 0,50% 0,50% 40%,100% 40%,100% 100%,50% 100%,50% 60%,0 60%)}.desktop-nav{margin-left:auto;display:flex;gap:30px;font-size:12px;font-weight:600}.header-contact{display:flex;gap:40px;align-items:center;font-size:12px;font-weight:600;min-height:42px;border-bottom:1px solid var(--ink)}.header-contact span{font-size:20px}.mobile-menu{display:none}.hero-topline{border-top:1px solid var(--ink);border-bottom:1px solid var(--line);display:flex;justify-content:space-between;padding:16px 0;font-family:'Sora Variable',sans-serif;letter-spacing:.11em;font-size:10px;font-weight:500}.hero-topline p{color:var(--blue)}.hero-topline>span{color:var(--muted)}.hero-main{display:grid;grid-template-columns:1fr 1.12fr;min-height:596px}.hero-copy{padding:43px 24px 52px 0;display:flex;flex-direction:column;align-items:flex-start}.eyebrow{display:flex;align-items:center;gap:10px;font-size:var(--size-label, 11px);letter-spacing:.07em;font-weight:600;color:var(--blue)}.tiny-square{width:5px;height:5px;background:var(--blue)}h1{font-size:var(--size-title, clamp(42px, 4.3